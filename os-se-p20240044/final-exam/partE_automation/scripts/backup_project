#!/bin/bash

SRC_DIR="$HOME/sample_project"
BACKUP_DIR="$HOME/os-se-p20240044/final-exam/partE_automation/backups"
RETAIN_N=2

mkdir -p "$BACKUP_DIR"

timestamp=$(date '+%Y%m%d_%H%M%S')
archive_name="project_${timestamp}.tar.gz"

tar -czf "$BACKUP_DIR/$archive_name" -C "$HOME" sample_project

echo "Created backup: $archive_name"

# prune: keep only the newest RETAIN_N archives
cd "$BACKUP_DIR" || exit 1
ls -1t project_*.tar.gz | tail -n +$((RETAIN_N + 1)) | while read -r old_archive; do
    echo "Pruning old backup: $old_archive"
    rm -f "$old_archive"
done

echo "Current backups:"
ls -lh "$BACKUP_DIR"
